# =============================================================================
# Unified server (port 80) - React SPA handles all routing
# Admin: /5d41402abc4b2a76b9719d911017c592/*
# C-end: /, /chat, /token-transfer.html
# =============================================================================
server {
    listen 80;
    server_name _ bidagent.konusmumu.com;
    root /ragflow/web/dist;

    gzip on;
    gzip_min_length 1k;
    gzip_comp_level 9;
    gzip_types text/plain application/javascript application/x-javascript text/css application/xml text/javascript application/x-httpd-php image/jpeg image/gif image/png;
    gzip_vary on;
    gzip_disable "MSIE [1-6]\.";

    # API routes
    location ~ ^/api/v1/admin {
        proxy_pass http://localhost:9381;
        include proxy.conf;
    }

    # SSE (Server-Sent Events) streaming endpoint
    location ~ ^/api/v1/agents/chat/completion {
        proxy_pass http://localhost:9380;
        include proxy.conf;
        # Ensure SSE headers are properly passed
        proxy_set_header Connection '';
        proxy_set_header Cache-Control 'no-cache';
        proxy_set_header X-Accel-Buffering 'no';
        # Chunked encoding for streaming
        chunked_transfer_encoding on;
    }

    # Collaboration WebSocket — prefix match takes priority over regex
    location ^~ /api/v1/collaboration/ws/ {
        proxy_pass http://localhost:9380;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location ~ ^/(v1|api) {
        proxy_pass http://localhost:9380;
        include proxy.conf;
    }

    # Docker internal DNS resolver (allow upstreams to not exist at startup)
    resolver 127.0.0.11 valid=30s;

    # Crawl4AI Service (management dashboard + REST API) — 未来调度服务
    location ^~ /5d41402abc4b2a76b9719d911017c592/crawler/ {
        set $crawler_upstream crawl4ai-service:8001;
        proxy_pass http://$crawler_upstream/;
        include proxy.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Crawl4AI Engine (内置 Dashboard + Playground + API) — 直接代理到爬虫引擎
    location ^~ /5d41402abc4b2a76b9719d911017c592/crawl4ai/ {
        proxy_pass http://crawl4ai:11235/;
        include proxy.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # Rewrite sub-path redirects: crawl4ai generates Location based on
        # the public Host header; fix the path prefix to include sub-path.
        proxy_redirect http://$host/ /5d41402abc4b2a76b9719d911017c592/crawl4ai/;
        # Note: playground HTML is patched at source (CRAWL4AI_BASE var)
        # to fix hardcoded absolute API paths (/crawl, /config/dump, etc.)
    }

    # Grafana monitoring (sub-path)
    location ^~ /5d41402abc4b2a76b9719d911017c592/monitor/ {
        set $monitor_upstream grafana:3000;
        proxy_pass http://$monitor_upstream/;
        include proxy.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Admin SPA - ^~ ensures alias takes priority over regex locations
    location ^~ /5d41402abc4b2a76b9719d911017c592/ {
        alias /ragflow/web/dist/;
        index index.html;
        try_files $uri $uri/ /5d41402abc4b2a76b9719d911017c592/index.html;

        # Cache all hashed static files (assets, chunks, entry modules)
        location ~ ^/5d41402abc4b2a76b9719d911017c592/(assets|chunk|entry)/ {
            expires 10y;
            access_log off;
            add_header Cache-Control "public, immutable";
        }
    }

    # Mobile App Downloads (APK / IPA / iOS install guide)
    location /downloads/ {
        alias /ragflow/downloads/;
        add_header Content-Disposition "";
        # APK MIME type
        types { application/vnd.android.package-archive apk; }
        default_type application/octet-stream;
    }

    # All other routes -> React SPA (C-end pages handled by React Router)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
